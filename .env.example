# Browser-safe Firebase Web App configuration only.
# Never place OpenAI or Stripe secret keys in this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Score-based reCAPTCHA Enterprise key registered with Firebase App Check.
VITE_FIREBASE_APPCHECK_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Development-only, explicit local acceptance switch. Never set this in a production build.
# VITE_USE_FIREBASE_EMULATORS=true
