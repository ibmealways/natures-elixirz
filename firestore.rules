rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow create, read, update, delete: if owns(userId);

      match /recipes/{recipeId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.ownerId == userId;
      }

      // Only trusted server code may write paid access.
      match /private/entitlement {
        allow read: if owns(userId);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
